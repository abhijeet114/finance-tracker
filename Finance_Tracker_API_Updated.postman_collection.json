	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"console.log('Finance Tracker API Collection - Request starting...');",
					"",
					"// Check if we need authentication for this request",
					"const url = pm.request.url.toString();",
					"if (url.includes('/api/transactions') && !url.includes('/api/auth/')) {",
					"    const token = pm.collectionVariables.get('authToken');",
					"    if (!token || token === '') {",
					"        console.warn('Warning: No authentication token found. Please login first.');",
					"    }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"console.log('Finance Tracker API Collection - Request completed with status:', pm.response.code);",
					"",
					"// Handle authentication errors",
					"if (pm.response.code === 401) {",
					"    console.error('Authentication failed. Please check your token or login again.');",
					"}",
					"",
					"if (pm.response.code === 403) {",
					"    console.error('Access forbidden. You may not have permission to access this resource.');",
					"}"
				]
			}
		}
	],
